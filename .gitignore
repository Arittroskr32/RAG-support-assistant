config/api_keys.yaml

# --- ChromaDB persistent storage (rebuildable from data/ + KB build scripts) ---
chroma_db/
**/chroma_db/

# --- Logs (append-only audit output) ---
logs/
*.log

# --- Model weights / caches (guardrail base model, adapters, HF cache) ---
models/
*.bin
*.safetensors
*.gguf
.cache/
huggingface_cache/

# --- Raw benchmark / red-team datasets (not the support-content data/) ---
data/security_datasets/*
!data/security_datasets/.gitkeep

# --- Jupyter ---
.ipynb_checkpoints/

# --- Evaluation outputs ---
eval/results/
.pytest_cache/
*.results.json

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Redis dump (if run locally for KB-1) ---
dump.rdb

# --- Frontend dev tooling (UI check script dependencies and outputs) ---
node_modules/
frontend/dev/uicheck/package-lock.json
frontend/dev/uicheck/.chrome-profile/
frontend/dev/uicheck/screenshots/

