# Copy to .env — config/settings.py loads it automatically (python-dotenv).

# L7 generation backend: "local" (default) or "anthropic"
GENERATION_BACKEND=local

# Local LLM — any OpenAI-compatible server (Ollama, LM Studio, llama.cpp server, vLLM)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1    # Ollama; LM Studio: http://localhost:1234/v1
LOCAL_LLM_MODEL=llama3.1:8b
# LOCAL_LLM_API_KEY=                            # only if your server requires one
# LOCAL_LLM_TEMPERATURE=0.1
# LOCAL_LLM_MAX_TOKENS=1500
# LOCAL_LLM_TIMEOUT_S=180

# Claude API (only when GENERATION_BACKEND=anthropic)
ANTHROPIC_API_KEY=
# GENERATION_MODEL=claude-opus-5

# KB-1 rate limiting via Redis (falls back to an in-memory store if Redis isn't reachable)
REDIS_HOST=localhost
REDIS_PORT=6379

# API
ALLOW_ANONYMOUS=true            # requests without an account or X-API-Key are served as role "public"
ALLOW_REGISTRATION=true         # anyone can create a browser account (starts as "public")
SESSION_TTL_HOURS=168           # how long a sign-in lasts
# SESSION_SECRET=               # signs the session cookie; default: generated into config/session_secret
TRUST_X_FORWARDED_FOR=false     # only set true behind a reverse proxy you control
WARMUP_GUARDRAIL=true           # load the L3 model at startup instead of on the first request

# L8: email domains that may appear in answers even if not in the retrieved context
L8_EMAIL_ALLOWLIST_DOMAINS=example.com

# Optional: ChromaDB location (default: ./chroma_db)
# CHROMA_PATH=
